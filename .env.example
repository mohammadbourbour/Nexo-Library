# Optional overrides for `docker compose`. Compose starts without this file.
# Copy: cp .env.example .env   — never commit .env (secrets).

# Public UI origin (CORS, cookie-backed auth, PDF iframe policy)
FRONTEND_URL=http://localhost:8080

# SPA API origin. Leave empty so the browser talks to /api on the UI origin
# (nginx proxies to the backend). Set only if you expose the API on another host.
VITE_API_URL=

# Override these in .env for anything beyond local demos
JWT_SECRET=replace-with-a-long-random-string
ADMIN_SECRET=replace-with-a-strong-admin-secret

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ENV=development

POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo
POSTGRES_DB=nexo_library

FRONTEND_PORT=8080
BACKEND_PORT=8000
POSTGRES_PORT=5432

# Optional university policy
# ALLOWED_EMAIL_DOMAIN=university.ac.ir
ENABLE_SIGNUP=true
MAX_PDF_SIZE_MB=80
MAX_COVER_SIZE_MB=5
