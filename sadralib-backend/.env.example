# Backend Environment Variables
# این فایل برای مثال است. فایل واقعی .env را با مقادیر صحیح ایجاد کنید و در git قرار ندهید

# Database Configuration
DATABASE_URL=postgresql://sadra:sadra_pass@localhost:5432/sadralib

# JWT Configuration
JWT_SECRET=change-me-to-a-strong-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Admin Secret - برای ایجاد اولین ادمین و سپس ایجاد ادمین‌های اضافی
ADMIN_SECRET=change-me-to-a-strong-admin-secret

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Frontend URL - برای CORS
FRONTEND_URL=http://localhost:8080

# Debug Mode - فقط در توسعه true کنید
DEBUG=False

# Production Example:
# DATABASE_URL=postgresql://user:password@prod-db.example.com:5432/sadralib
# JWT_SECRET=<your-very-secure-secret>
# ADMIN_SECRET=<your-very-secure-admin-secret>
# FRONTEND_URL=https://your-frontend.com
# DEBUG=False
