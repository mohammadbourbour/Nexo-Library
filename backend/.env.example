DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo_library
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
UPLOAD_DIR=./uploads
FRONTEND_URL=http://localhost:8080
ADMIN_SECRET=replace-with-a-strong-admin-secret
ENV=development
# Optional university signup restriction, e.g. university.ac.ir
# ALLOWED_EMAIL_DOMAIN=
# ENABLE_SIGNUP=true
MAX_PDF_SIZE_MB=80
MAX_COVER_SIZE_MB=5
